/*
 * Device-tree overlay: r3.0-study mezzanine (MMDVM + Meshtastic + GPS + 1S4P)
 * on a uCRobotics Bubblegum-96 (Actions S900).
 *
 * STATUS: NEVER COMPILED, NEVER BOOTED. No dtc was available where this file
 * was written and the board does not exist yet. Treat every node as a draft.
 *
 * Base tree: mainline arch/arm64/boot/dts/actions/s900-bubblegum-96.dts
 * (+ s900.dtsi). Labels used from the base tree: uart2, i2c1, pinctrl.
 *
 * Why an overlay, and how to use it
 * ---------------------------------
 * The file uses only label references (&uart2, &i2c1, &pinctrl) and path
 * references (&{/}, &{/aliases}), so the same text works in two ways:
 *
 *  1. As an overlay (default). The base DTB must be built with symbols
 *     (make DTC_FLAGS=-@ dtbs). Then either
 *       - merge at build time (no boot-loader support needed):
 *           fdtoverlay -i s900-bubblegum-96.dtb -o merged.dtb mmdvm-mesh.dtbo
 *       - or let U-Boot apply it (fdt apply), if the boot chain in use
 *         supports that. The boot chain of the user's image is not known.
 *     See build-dtbo.sh next to this file.
 *
 *  2. Included into the board file of a self-maintained kernel tree:
 *       #define MMDVM_MESH_STATIC
 *       #include "mmdvm-mesh-overlay.dts"
 *     appended at the end of s900-bubblegum-96.dts.
 *
 * The mainline kernel has no run-time overlay loader for this platform
 * (no configfs interface), and owl-uart takes its line number from
 * /aliases at boot, so the overlay has to be applied before the kernel
 * starts in either case.
 *
 * Host pin map (verified against two sources, see README "Sources"):
 *
 *   LS pin  96Boards   S900 pad   pinctrl line  mezzanine net / use
 *   5       UART0_TxD  GPIOB15    (uart2 tx)    -> U21 -> STM32 USART1 RX
 *   7       UART0_RxD  GPIOB14    (uart2 rx)    <- U20 <- STM32 USART1 TX
 *   11/13   UART1      GPIOA27/25 (uart5)       console, already enabled
 *   15/17   I2C0       GPIOB22/23 (i2c1)        TCA9406 -> 3.3 V always-on bus
 *   23      GPIO-A     GPIOA0     0             out: STM32 BOOT0 (U22)
 *   24      GPIO-B     GPIOA1     1             out: STM32 NRST, low = reset (U23)
 *   25      GPIO-C     GPIOA2     2             in:  SC16IS752 IRQ, active low
 *   26      GPIO-D     GPIOA3     3             in:  BQ25895 INT + MAX17048 ALRT, active low
 *   27      GPIO-E     GPIOA4     4             in:  STM6601 INT (power key), active low
 *   28      GPIO-F     GPIOA5     5             out: power hold, only with JP2 2-3
 *   29      GPIO-G     GPIOA6     6             out: RAK4630 reset, low = reset (U26)
 *   30      GPIO-H     GPIOA7     7             in:  GPS PPS (U27)
 *   31      GPIO-I     GPIOA8     8             in:  GPS slide switch state (U28)
 *   32      GPIO-J     GPIOA9     9             in:  EMC2301 ALERT, active low
 *   33/34   GPIO-K/L   GPIOE27/26 133 / 132     not connected on the mezzanine
 *
 * Sources: hardware manual V1.1 section 5 (LS connector table) and the
 * gpio-line-names table in mainline s900-bubblegum-96.dts. Both agree.
 *
 * gpio-line-names: mainline already names lines 0..9 "GPIO-A".."GPIO-J" (and
 * 133/132 "GPIO-K"/"GPIO-L"). An overlay can only replace the whole
 * 146-entry property, so it is deliberately not repeated here. Use the
 * 96Boards names with libgpiod (gpiofind GPIO-G) and the table above.
 *
 * GPIO-A, -B and -G are left to user space (gpio/mmdvm-gpio.sh, stm32flash).
 * They are NOT hogged here because a hog would block stm32flash.
 */

#ifndef MMDVM_MESH_STATIC
/dts-v1/;
/plugin/;
#endif

#include <dt-bindings/gpio/gpio.h>
#include <dt-bindings/input/input.h>
#include <dt-bindings/interrupt-controller/irq.h>

&{/aliases} {
	/*
	 * owl-uart refuses to probe without a serialN alias
	 * (drivers/tty/serial/owl-uart.c: of_alias_get_id). uart2 -> ttyOWL2.
	 */
	serial2 = "/soc/serial@e0124000";
};

&{/} {
	/*
	 * Y2, 14.7456 MHz crystal on the SC16IS752 (XTAL1/XTAL2).
	 * Binding: Documentation/devicetree/bindings/clock/fixed-clock.yaml
	 */
	sc16is752_xtal: clock-14745600 {
		compatible = "fixed-clock";
		#clock-cells = <0>;
		clock-frequency = <14745600>;
	};

	/*
	 * GPS time pulse (MAX-M10S TIMEPULSE -> U27 -> GPIO-H), rising edge.
	 * Binding: Documentation/devicetree/bindings/pps/pps-gpio.yaml
	 */
	pps {
		compatible = "pps-gpio";
		gpios = <&pinctrl 7 GPIO_ACTIVE_HIGH>;
	};

	/*
	 * Power key of the mezzanine: STM6601 INT pulses low (20..44 ms,
	 * data sheet tINT_Min) on a short push while the host is running.
	 * Reported as KEY_POWER so systemd-logind starts a normal shutdown.
	 * Binding: Documentation/devicetree/bindings/input/gpio-keys.yaml
	 * Not in the study's software list (section 8); it implements the
	 * "GPIO-E: power key INT (shutdown request)" row of section 3.4.
	 * The S900 GPIO block has no both-edge interrupt; pinctrl-owl emulates
	 * it. Whether a 20 ms pulse is caught reliably is untested.
	 */
	gpio-keys {
		compatible = "gpio-keys";

		key-power {
			label = "mezzanine power key";
			linux,code = <KEY_POWER>;
			gpios = <&pinctrl 4 GPIO_ACTIVE_LOW>;
			debounce-interval = <5>;
		};
	};

	/*
	 * Fallback power-off path (study section 2.2 / 3.4 / 16.10).
	 * Binding: Documentation/devicetree/bindings/power/reset/gpio-poweroff.yaml
	 *
	 * DISABLED by default, because the board default is JP2 1-2: the
	 * STM6601 PS_HOLD input follows the host +1V8 rail and GPIO-F is not
	 * connected to anything. Enable this node only after moving JP2 to 2-3.
	 *
	 * With JP2 2-3: GPIO-F high = hold power, low = power off (U29 -> PS_HOLD).
	 * GPIO_ACTIVE_LOW makes the driver drive the line high at probe
	 * (inactive) and low at power-off (active).
	 *
	 * Open problems with JP2 2-3 (all untested):
	 *  - PS_HOLD must be high when the STM6601 tON_BLANK ends (5.6 s min
	 *    after the power key). The kernel will not probe this driver that
	 *    early; the boot loader has to drive GPIO-F high first, or the
	 *    start-up assist C142/R124 (not fitted) has to be populated.
	 *  - If the kernel in use already has a working PMIC power-off handler,
	 *    two handlers are registered; the order depends on "priority".
	 *
	 * active-delay-ms is long so that the supply is gone before the driver
	 * toggles the line back (it pulses active -> inactive -> active).
	 */
	gpio-poweroff {
		compatible = "gpio-poweroff";
		gpios = <&pinctrl 5 GPIO_ACTIVE_LOW>;
		active-delay-ms = <2000>;
		timeout-ms = <3000>;
		status = "disabled";
	};
};

/*
 * LS UART0 = S900 UART2 -> STM32 USART1 (MMDVM_HS host link, 115200 8N1),
 * also the STM32 ROM boot-loader port for stm32flash (8E1).
 * Binding: Documentation/devicetree/bindings/serial/actions,owl-uart.yaml
 *
 * No pinctrl entry: pinctrl-s900.c lists the uart2_rx / uart2_tx pads only in
 * the "uart2_dummy" group (no mux register), like i2c1 in the base tree.
 * TODO(verify on hardware): that these pads really come up as UART2 without
 * any pinmux setting. RTS/CTS (LS pins 9/3) are not connected on the board.
 */
&uart2 {
	status = "okay";
};

/*
 * LS I2C0 = S900 I2C1 (already "okay" in the base tree, 2.2 k pull-ups to
 * 1.8 V on the Bubblegum-96). On the mezzanine U34 (TCA9406) translates it to
 * the 3.3 V always-on bus SDA_AON / SCL_AON. Every device below sits on that
 * bus and is powered from +3V3_MESH (always on), so it answers whenever the
 * host is up. The nRF52840 is NOT on this bus (its I2C only goes to the
 * front-panel OLED), so there is no second master.
 *
 * Addresses are taken from hardware/r3.0-study/gen/r30_parts.py and
 * r30_parts2.py.
 */
&i2c1 {
	/*
	 * U35 SC16IS752, A0 = A1 = VDD -> 0x48.
	 *   channel A (ttySC0): RAK4630 serial module, P0.19 / P0.20, 115200
	 *   channel B (ttySC1): GPS NMEA, receive only (TXB is not connected)
	 * IRQ: open drain through U30 to GPIO-C, 10 k pull-up to 1.8 V.
	 * RESET is RC only (no host GPIO). The 8 GPIO pins are unconnected, so no
	 * gpio-controller.
	 * Binding: Documentation/devicetree/bindings/serial/nxp,sc16is7xx.yaml
	 * ttySC0/ttySC1 assume this is the only sc16is7xx in the system.
	 */
	serial@48 {
		compatible = "nxp,sc16is752";
		reg = <0x48>;
		clocks = <&sc16is752_xtal>;
		interrupt-parent = <&pinctrl>;
		interrupts = <2 IRQ_TYPE_LEVEL_LOW>;
	};

	/*
	 * U36 EMC2301-1 fan controller, 0x2f. (The study text still says
	 * AMC6821; the schematic and the BOM have EMC2301 + TMP102.)
	 * Binding: Documentation/devicetree/bindings/hwmon/microchip,emc2305.yaml
	 * pwms cells: frequency (Hz), polarity (0 = normal), output (1 = push-pull).
	 * Push-pull is required: the PWM pin drives the gate of Q20 (AO3400A)
	 * with only a 100 k pull-down (R55); the chip default is open drain,
	 * which would never turn the fan on.
	 * TODO(verify): 26 kHz low-side switching of a 3-wire fan; the tach
	 * signal may be unusable below 100 % duty.
	 */
	fan_ctrl: fan-controller@2f {
		compatible = "microchip,emc2301", "microchip,emc2305";
		reg = <0x2f>;
		#address-cells = <1>;
		#size-cells = <0>;
		#pwm-cells = <3>;

		fan@0 {
			reg = <0x0>;
			pwms = <&fan_ctrl 26000 0 1>;
			#cooling-cells = <2>;
		};
	};

	/*
	 * U37 TMP102, ADD0 = V+ -> 0x49. Air temperature at the outlet of the
	 * SoC column (not the SoC die temperature). ALERT is not connected.
	 * Binding: Documentation/devicetree/bindings/hwmon/ti,tmp102.yaml
	 */
	temperature-sensor@49 {
		compatible = "ti,tmp102";
		reg = <0x49>;
	};

	/*
	 * U105 INA226, A0 = A1 = GND -> 0x40. 10 mOhm shunt (R115) in the 12 V
	 * feed to SYS_DCIN: host input power. ALERT is not connected.
	 * Binding: Documentation/devicetree/bindings/hwmon/ti,ina2xx.yaml
	 */
	power-sensor@40 {
		compatible = "ti,ina226";
		reg = <0x40>;
		shunt-resistor = <10000>;	/* micro-ohm */
	};

	/*
	 * U103 MAX17048 fuel gauge, 0x36.
	 * Binding: Documentation/devicetree/bindings/power/supply/maxim,max17040.yaml
	 * No "interrupts": ALRT shares the PWR_INT_N line (GPIO-D) with the
	 * charger and neither max17040_battery.c nor bq25890_charger.c
	 * requests its interrupt with IRQF_SHARED. The charger binding makes
	 * "interrupts" mandatory, so the charger gets the line. The gauge is
	 * polled; its low-SOC alert is not used.
	 */
	fuel-gauge@36 {
		compatible = "maxim,max17048";
		reg = <0x36>;
	};

	/*
	 * U101 BQ25895 charger, 0x6a. INT is open drain (R106 to +3V3_MESH)
	 * through U31 to GPIO-D, 10 k pull-up to 1.8 V.
	 * Binding: Documentation/devicetree/bindings/power/supply/bq25890.yaml
	 *
	 * The values are a starting point, not a validated charge profile:
	 *  - 4.208 V / cell group (chip default). The study suggests 4.1 V for
	 *    permanent mains operation (section 4.5).
	 *  - 3.008 A for the 4P pack = 0.75 A per cell. TODO(user): set for the
	 *    cells actually fitted and the measured holder temperature rise.
	 *  - termination 256 mA, pre-charge 256 mA, minimum system 3.5 V.
	 *  - boost (OTG) values are mandatory in the binding but unused: the
	 *    USB-C port is sink only.
	 *  - ti,use-ilim-pin: keep it. The ILIM pin sets the hardware input limit for an unknown adapter: about
	 *    1.37 A typ / 1.50 A max with VBUS at 9 V and 0.45 A typ / 0.49 A max at 5 V (R102, R128, Q105);
	 *    without this property the driver clears EN_ILIM and the register limit (3.25 A for a DCP) applies.
	 * Note: the driver disables the chip's I2C watchdog, so these settings
	 * stay in force after the host shuts down (the chip stays powered).
	 */
	charger@6a {
		compatible = "ti,bq25895", "ti,bq25890";
		reg = <0x6a>;
		interrupt-parent = <&pinctrl>;
		interrupts = <3 IRQ_TYPE_EDGE_FALLING>;

		ti,battery-regulation-voltage = <4208000>;
		ti,charge-current = <3008000>;
		ti,termination-current = <256000>;
		ti,precharge-current = <256000>;
		ti,minimum-sys-voltage = <3500000>;
		ti,boost-voltage = <4998000>;
		ti,boost-max-current = <500000>;
		ti,use-ilim-pin;
	};
};
