# YSFGateway between MMDVM-Host and the YSF / FCS reflectors. UNTESTED.
# Installed by build-gateways.sh, not enabled by default.
[Unit]
Description=YSFGateway
After=network-online.target mosquitto.service gpsd.service
Wants=network-online.target mosquitto.service
Before=mmdvmhost.service
ConditionPathExists=/etc/YSFGateway.ini

[Service]
Type=simple
User=mmdvm
Group=mmdvm
WorkingDirectory=/var/lib/mmdvm
ExecStart=/usr/local/bin/YSFGateway /etc/YSFGateway.ini
Restart=on-failure
RestartSec=10

[Install]
WantedBy=multi-user.target
