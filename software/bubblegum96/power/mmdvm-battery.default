# /etc/default/mmdvm-battery - limits for /usr/local/sbin/mmdvm-battery (sourced by bash).
# Starting values, not measured on hardware.

# Gauge state of charge (%) at or below which the host shuts down.
SOC_MIN=8
# Cell voltage (mV) at or below which the host shuts down, whatever the gauge says.
# The protector opens at 2800 mV; the 12 V boost needs margin above that.
VOLT_MIN_MV=3250
# Consecutive low readings required (a transmit burst sags the voltage briefly).
COUNT=3
# Seconds between readings.
INTERVAL=30
# 1 = log only, never shut down (for bring-up).
DRY_RUN=0
