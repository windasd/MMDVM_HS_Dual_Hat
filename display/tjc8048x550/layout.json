       "}",
       "if(MMDVM.status.val==12)",
       "{",
       "  t1.pco=65056",
       "}",
       "if(MMDVM.status.val==13)",
       "{",
       "  t1.txt=\"ERROR\"",
       "  t1.pco=64073",
       "}",
       "if(MMDVM.status.val==14)",
       "{",
       "  t1.pco=64073",
       "}",
       "if(MMDVM.status.val==15)",
       "{",
       "  t1.txt=\"LOCKOUT\"",
       "  t1.pco=64073",
       "}",
       "if(MMDVM.status.val==19)",
       "{",
       "  t1.txt=\"MMDVM STOPPED\"",
       "  t1.pco=64073",
       "}"
      ]
     },
